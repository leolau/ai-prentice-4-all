# app-mcp service environment (0600, NOT committed).
#
# Shared HMAC secret — MUST equal AGENT_HOME_APP_MCP_SECRET in
# agent-home/agent-home.env. The BFF signs 60s WebSocket tickets with it;
# this service verifies them. Generate once:  openssl rand -hex 32
APP_MCP_TICKET_SECRET=

# Loopback ports (defaults shown; Caddy fronts only the WS one).
APP_MCP_PORT=9220
APP_MCP_WS_PORT=9221

# Seconds to wait for the browser to execute a command before reporting a
# timeout back to the agent.
APP_MCP_COMMAND_TIMEOUT=10
