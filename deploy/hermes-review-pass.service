; Hermes review pass — the clock for the FG-29/FG-30/FG-31 learning loop.
; See docs/design/master-plan/feature-groups/FG-30-profile-lifecycle-and-suggestion.md.
;
; Tracked in git and installed from here, not hand-written on the box:
;   install -m 644 deploy/hermes-review-pass.service /etc/systemd/system/
;   install -m 644 deploy/hermes-review-pass.timer   /etc/systemd/system/
;   systemctl daemon-reload && systemctl enable --now hermes-review-pass.timer
;
; deploy_state.py's unit glob is `hermes-*`, so the installed copy and its hash
; land in the deployment-state repo and a divergence from this file shows up in
; the weekly drift check.
;
; Why a timer at all: every output of the loop that a human is meant to read —
; promotion candidates, sibling-goal conflicts, profile suggestions, idle
; profiles, capacity headroom — was reachable only by someone typing a command.
; On a box nobody types on, `generate_suggestion()` therefore never ran: FG-30's
; headline behaviour ("the system suggests more profiles over time") could not
; happen, and its 30-day interval and one-open cap were guarding a door nobody
; opened. This unit is the door being opened, on a clock.
;
; Weekly, not monthly, even though generation is monthly: the digest half is
; weekly by design (FG-29), and `generate_suggestion()` enforces its own cadence
; internally, so running it weekly still yields at most one suggestion a month.
; The gate stays in the function; the schedule stays dumb.

[Unit]
Description=Hermes weekly review pass (suggestion generation, conflicts, digest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent
Environment=HERMES_HOME=/opt/data/hermes-home-staging
ExecStart=/opt/data/hermes-agent/.venv/bin/hermes promotion review-pass

; The pass calls the aux LLM for suggestion naming and reads the whole goal
; tree. Losing to a live conversation is the correct outcome.
Nice=10
IOSchedulingClass=idle
CPUWeight=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/data/hermes-home-staging /opt/data/hermes-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
