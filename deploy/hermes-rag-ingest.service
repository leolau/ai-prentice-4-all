; Hermes Drive → RAG ingestion, one staged pass. See docs/deployment/rag-ingestion.md.
;
; Tracked in git and installed from here, not hand-written on the box:
;   install -m 644 deploy/hermes-rag-ingest.service /etc/systemd/system/
;   install -m 644 deploy/hermes-rag-ingest.timer   /etc/systemd/system/
;   systemctl daemon-reload && systemctl enable --now hermes-rag-ingest.timer
;
; deploy_state.py's unit glob is `hermes-*`, so the installed copy and its hash
; land in the deployment-state repo and a divergence from this file shows up in
; the weekly drift check.
;
; One pass per run, bounded by --limit, newest modification first. A full
; backfill of an established Drive account is hours of embedding, so it arrives
; over many nights instead of one long job that starves the gateway. Unchanged
; documents cost nothing, so a pass that has caught up is nearly free.

[Unit]
Description=Hermes Drive ingestion into the layer-4 vector store (one pass)
After=network-online.target hermes-embed.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent
Environment=HERMES_HOME=/opt/data/hermes-home-staging
ExecStart=/opt/data/hermes-agent/.venv/bin/hermes memory rag \
    --as leo_owner ingest-drive --limit 100

# Embedding is the expensive step and the gateway shares these 4 vCPUs. Losing
# to a live conversation is the correct outcome for a background backfill.
Nice=15
IOSchedulingClass=idle
CPUWeight=20

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/data/hermes-home-staging /opt/data/hermes-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
